# Database Connection (Neon / Supabase / Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rent_a_api?schema=public"

# Node Crypto AES-256-GCM Master Key (32 bytes / 256-bit secret)
ENCRYPTION_KEY="rent-a-api-p2p-zero-commission-secure-production-key-32b!"

# Robinhood Chain (Arbitrum L2 EVM) RPC & Contracts
NEXT_PUBLIC_RPC_URL="https://sepolia-rollup.arbitrum.io/rpc"
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_RENT_TOKEN_ADDRESS="0x4444444444444444444444444444444444444444"
NEXT_PUBLIC_MARKETPLACE_ADDRESS="0x5555555555555555555555555555555555555555"

# Uniswap v4 TWAP Benchmark Rate (USD per 1 RENT token, e.g. 0.05 USD = 1 RENT)
NEXT_PUBLIC_RENT_TWAP_USD="0.05"

# Fastify Dedicated Reverse Proxy Service
PROXY_PORT=4000
NEXT_PUBLIC_PROXY_URL="http://localhost:4000/v1/chat/completions"
